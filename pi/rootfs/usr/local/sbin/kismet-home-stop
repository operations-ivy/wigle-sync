#!/bin/sh
# Fired by the kismet-home-stop timer after home wifi has been up for the grace
# period. Stops kismet and, if the Pi never left home since boot (i.e. this was
# just a boot-at-home session, not a real drive), deletes that session's logs.
LOGDIR=/var/log/kismet
LEFT_MARKER=${KISMET_LEFT_MARKER:-/run/kismet-left-home}  # written by kismet-left-home
SBIN=${KISMET_SBIN:-/usr/local/sbin}  # KISMET_* paths: for tests only

# Off home wifi right now: wait out a blip (the dispatcher's 120 s grace), so
# a drop just as this fires doesn't leave kismet running at home. Still off
# after that: the Pi has left, and kismet-left-home has taken over.
tries=0
until "$SBIN/on-home-wifi"; do
  tries=$((tries + 1))
  [ "$tries" -gt 30 ] && exit 0
  sleep 5
done

pid=$(systemctl show -p MainPID --value kismet.service)
bases=""
if [ -n "$pid" ] && [ "$pid" != 0 ]; then
  # Session files = whatever kismet has open in the log dir; strip extension to base.
  bases=$(for fd in /proc/"$pid"/fd/*; do readlink "$fd"; done 2>/dev/null \
    | grep "^$LOGDIR/Kismet-" | sed -E 's/\.[^./]+$//' | sort -u)
fi

systemctl stop kismet.service

if [ -e "$LEFT_MARKER" ]; then
  echo "left home since boot; keeping session logs"
  exit 0
fi
for b in $bases; do
  for f in "$b".*; do
    [ -e "$f" ] || continue
    echo "removing $f"
    rm -f -- "$f"
  done
done
