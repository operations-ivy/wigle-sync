#!/bin/sh
# Stop kismet once home wifi has been up for DELAY (grace period so a boot in
# the driveway, waiting on a GPS fix before driving off, keeps kismet running).
# Being off home wifi for LEFT_DELAY counts as leaving: kismet-left-home then
# cancels a pending stop, (re)starts kismet, and marks this boot as a real
# outing so kismet-home-stop keeps its logs. A shorter drop is a blip (the
# link fell and came back at home) and changes nothing: no outing, no new
# stop, and a stop timer someone cancelled by hand stays cancelled.
# The KISMET_* paths are for tests; NetworkManager sets none of them.
DELAY=900       # seconds
LEFT_DELAY=120  # seconds off home wifi before it counts as leaving
UNIT=kismet-home-stop
LEFT_UNIT=kismet-left-home
SBIN=${KISMET_SBIN:-/usr/local/sbin}
. "${KISMET_PI_DEFAULTS:-/etc/default/kismet-pi}"
[ "$1" = wlan_host ] || exit 0
[ -n "$CONNECTION_UUID" ] || exit 0
ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CONNECTION_UUID" 2>/dev/null)
[ "$ssid" = "$HOME_WIFI_SSID" ] || exit 0
# Timers are due at a time since boot, not --on-active: systemd re-arms a
# relative timer on every daemon-reload (an apt upgrade, bootstrap.sh),
# postponing it, and at boot the wall clock may still be hours behind.
up=$(cut -d. -f1 "${KISMET_UPTIME:-/proc/uptime}")
case "$2" in
  up)
    # Still waiting to fire (not fired, not elapsed): back within the grace.
    if [ "$(systemctl show -p SubState --value "$LEFT_UNIT.timer" 2>/dev/null)" = waiting ]; then
      systemctl stop "$LEFT_UNIT.timer" 2>/dev/null || true
      echo "home wifi back within ${LEFT_DELAY}s: a blip, not an outing"
      exit 0
    fi
    systemctl stop "$UNIT.timer" 2>/dev/null || true
    systemctl reset-failed "$UNIT.service" 2>/dev/null || true
    systemd-run --collect --unit="$UNIT" --on-boot=$((up + DELAY)) "$SBIN/kismet-home-stop"
    ;;
  down)
    systemctl stop "$LEFT_UNIT.timer" 2>/dev/null || true
    systemctl reset-failed "$LEFT_UNIT.service" 2>/dev/null || true
    systemd-run --collect --unit="$LEFT_UNIT" --on-boot=$((up + LEFT_DELAY)) "$SBIN/kismet-left-home"
    ;;
esac
