[Unit]
Description=Kismet phone AP (hostapd on wlan_ap)
Wants=network.target
After=network.target sys-subsystem-net-devices-wlan_ap.device

[Service]
Type=simple
ExecStartPre=-/usr/sbin/ip link set wlan_ap down
ExecStartPre=-/usr/sbin/iw dev wlan_ap set type managed
ExecStartPre=/usr/sbin/ip link set wlan_ap up
ExecStartPre=-/usr/sbin/ip addr flush dev wlan_ap
ExecStartPre=/usr/sbin/ip addr add 192.168.50.1/24 dev wlan_ap
ExecStart=/usr/sbin/hostapd /etc/hostapd/hostapd-wlan_ap.conf
# hostapd can drop the address while it brings the interface up.
ExecStartPost=-/usr/sbin/ip addr replace 192.168.50.1/24 dev wlan_ap
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
