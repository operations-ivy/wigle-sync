[Unit]
Description=Kismet phone AP DHCP (dnsmasq on wlan_ap)
BindsTo=kismet-ap.service
# BindsTo stops dnsmasq when hostapd stops; PartOf also brings it back on a restart.
PartOf=kismet-ap.service
After=kismet-ap.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/kismet-ap/dnsmasq.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
