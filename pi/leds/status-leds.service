[Unit]
Description=LED2 (Flock and Axon alert, from Kismet) and LED3 (temperature) (status-leds.py)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/wigle-leds/status-leds.py
Environment=LOG_FORMAT=json
LoadCredential=kismet-httpd:/home/zaphod/.kismet/kismet_httpd.conf
# Root for the PWM's sysfs files; everything else read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
