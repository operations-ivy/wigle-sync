[Unit]
Description=LED2: red and white near a Flock camera or Axon device, else breathing green (led2-alert.py)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/wigle-leds/led2-alert.py
LoadCredential=kismet-httpd:/home/zaphod/.kismet/kismet_httpd.conf
# Root for the PWM's sysfs files; everything else read-only.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
