# Settings for bootstrap.sh and the home-wifi scripts. Copy to the Pi as
# /etc/default/kismet-pi (mode 600, root) and fill in. Never commit the filled-in
# copy: the SSIDs place the Pi on WiGLE's map, and the passphrase is a secret.

# SSID of the home network the onboard radio joins. Kismet stops 15 minutes
# after joining it, and a session that never left home is deleted unsent.
HOME_WIFI_SSID=

# The phone AP on wlan_ap, for reaching Kismet's UI at http://192.168.50.1:2501.
AP_SSID=
AP_PASSPHRASE=
AP_CHANNEL=6

# Public half of wigle-sync's SSH key (~/.ssh/wigle_sync_ed25519.pub). Leave
# empty to skip creating the wigle-sync user.
WIGLE_SYNC_PUBKEY=
