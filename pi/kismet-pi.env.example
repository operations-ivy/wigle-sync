# Settings for bootstrap.sh and the home-wifi scripts. Copy to the Pi as
# /etc/default/kismet-pi (mode 600, root) and fill in. Never commit the filled-in
# copy: the SSIDs place the Pi on WiGLE's map, and the passphrase is a secret.

# SSID of the home network the onboard radio joins. Kismet stops 15 minutes
# after joining it, and a session that never left home is deleted unsent.
HOME_WIFI_SSID=""

# Public half of wigle-sync's SSH key (~/.ssh/wigle_sync_ed25519.pub). Leave
# empty to skip creating the wigle-sync user. Keep the quotes: bootstrap.sh
# sources this file, and the key has spaces in it.
WIGLE_SYNC_PUBKEY=""

# The board: auto (detect it), default (brick69's Pi 3B+: the RGB status
# LEDs) or zero2w (a Pi Zero 2 W: tuned for 512 MB, no LEDs).
PI_PROFILE=auto

# The handheld's extras, off unless set to 1 (README, "A Pi Zero 2 W
# handheld"): the e-ink status display, and the PiSugar 2 battery's metrics,
# low-battery shutdown and RTC. Their settings are in /etc/wigle-pi/handheld.yaml.
EINK=0
PISUGAR=0
# A second capture radio, off unless set to 1: a 2.4 GHz dongle named wlan_mon1
# (rootfs/etc/systemd/network/10-wlan_mon1.link) takes 2.4 GHz and wlan_mon0
# keeps to 5 GHz (pi/kismet/wifi-split.conf).
WIFI_SPLIT=0
