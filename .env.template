# Copy to .env and fill in. .env is git-ignored; this template is not.

# WiGLE API credentials — https://wigle.net/account (API Token section)
WIGLE_API_NAME=AIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WIGLE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "true" permits WiGLE commercial use of uploaded data
WIGLE_DONATE=false

# Raspberry Pi that runs Kismet
PI_HOST=192.168.1.x
PI_PORT=22
PI_USER=wigle-sync
PI_SSH_KEY_PATH=~/.ssh/wigle_sync_ed25519
# Pin the Pi host key: ssh-keyscan -t ed25519 <PI_HOST> > known_hosts
PI_KNOWN_HOSTS_PATH=./known_hosts
# Directory Kismet writes its logs to, and where uploaded files get moved
PI_REMOTE_DIR=/var/log/kismet
PI_ARCHIVE_DIR=/var/log/kismet/uploaded
# Seconds to wait on the up-front "is the Pi home?" TCP probe
PI_PROBE_TIMEOUT=3

# Files modified more recently than this are assumed to still be open by Kismet
MIN_FILE_AGE_SECONDS=300
FILE_EXTENSIONS=.kismet,.wiglecsv
# tar.gz before upload (WiGLE caps uploads at 180 MiB)
COMPRESS_UPLOADS=true
